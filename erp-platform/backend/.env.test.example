APP_NAME="Rigaud Tech Platform ERP"
APP_DESCRIPTION="Backend da Rigaud Tech Platform ERP."
APP_ENV=test
APP_DEBUG=false
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=WARNING
DATABASE_URL=postgresql+psycopg://rigaud:rigaud@localhost:5432/rigaud_erp_test
DATABASE_ECHO=false
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=1800
DATABASE_HEALTH_TIMEOUT_SECONDS=3
JWT_SECRET_KEY=test-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=5
JWT_REFRESH_TOKEN_EXPIRE_DAYS=1
JWT_ISSUER=
JWT_AUDIENCE=
PASSWORD_HASH_SCHEME=bcrypt
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=72
