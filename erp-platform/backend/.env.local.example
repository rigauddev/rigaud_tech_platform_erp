APP_NAME="Rigaud Tech Platform ERP"
APP_DESCRIPTION="Backend da Rigaud Tech Platform ERP."
APP_ENV=local
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=DEBUG
DATABASE_URL=postgresql+psycopg://rigaud:rigaud@localhost:5432/rigaud_erp
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_HEALTH_TIMEOUT_SECONDS=3
JWT_SECRET_KEY=local-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=
JWT_AUDIENCE=
PASSWORD_HASH_SCHEME=bcrypt
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=72
